From 839940c21152bd0636d62c89c4a69134ecc4b41e Mon Sep 17 00:00:00 2001
From: mpoons <mpoons@users.noreply.github.com>
Date: Tue, 15 Sep 2026 14:00:25 +0000
Subject: [PATCH 3/5] sheets: twee sluitingen vlak na elkaar stuurden de
 browser te ver terug
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

closeSheet berekende het aantal terugstappen uit history.state, maar history.go
is asynchroon: sloot een bevestigingssheet zichzelf en deed de actie daarna
closeSheet(true), dan telde de eerste terugstap nog een keer mee. Wie de app via
een link opende, belandde na Verwijderen (detail → bevestigen) op de vorige
pagina; als app op het beginscherm kwam de terugstap nooit aan en slikte de
terugknop daarna één keer. Nu telt wat er nog onderweg is mee.

Nagespeeld in headless Chromium: op main verlaat Verwijderen de app, hierna niet.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_011SwgqVVr93qHAFGj6ur81b
---
 cellarmentor.html | 14 +++++++++-----
 1 file changed, 9 insertions(+), 5 deletions(-)

diff --git a/cellarmentor.html b/cellarmentor.html
index 9809bd9..edfb00b 100644
--- a/cellarmentor.html
+++ b/cellarmentor.html
@@ -867,7 +867,7 @@ addEventListener('unhandledrejection', ev => { const nu = Date.now(); if(nu - la
 
 /* ================= sheets & toast ================= */
 const sheets = [];
-let sheetSkipPops = 0, sheetNaPop = [];
+let sheetSkipPops = 0, sheetNaPop = [], sheetPopsOnderweg = []; /* per history.go die nog niet is aangekomen: hoeveel stappen terug */
 function openSheet(html, opts={}){
   const host = document.getElementById('sheetHost');
   const ov = document.createElement('div'); ov.className = 'overlay';
@@ -898,14 +898,18 @@ function closeSheet(all, viaPop){
   /* Onderweg is er opgeslagen (voorraad +1 in het detail): de lijst erachter toont nog het oude getal */
   if(!sheets.length && renderNaSluiten) setTimeout(() => { if(renderNaSluiten && !sheets.length){ renderNaSluiten = false; renderTenzijFormulier(); } }, 0);
   if(!viaPop){
-    /* gesloten via de app zelf: de bijbehorende geschiedenisstappen weer weghalen */
+    /* gesloten via de app zelf: de bijbehorende geschiedenisstappen weer weghalen. history.go is asynchroon en
+       history.state loopt dus achter; wat een vorige aanroep al terugstuurde telt niet nog eens mee (twee sluitingen
+       vlak na elkaar, zoals bevestigen + alles dichtdoen, stuurden anders te ver terug: de app uit, of een
+       terugstap die nooit aankomt en de terugknop daarna één keer laat "slikken") */
     const st = (history.state && history.state.sheet) || 0;
-    const terug = st - sheets.length;
-    if(terug > 0){ sheetSkipPops++; try{ history.go(-terug); }catch(e){ sheetSkipPops--; } }
+    const onderweg = sheetPopsOnderweg.reduce((a, b) => a + b, 0);
+    const terug = st - onderweg - sheets.length;
+    if(terug > 0){ sheetSkipPops++; sheetPopsOnderweg.push(terug); try{ history.go(-terug); }catch(e){ sheetSkipPops--; sheetPopsOnderweg.pop(); } }
   }
 }
 addEventListener('popstate', () => {
-  if(sheetSkipPops > 0){ sheetSkipPops--; sheetNaPop.splice(0).forEach(f => f()); return; }
+  if(sheetSkipPops > 0){ sheetSkipPops--; sheetPopsOnderweg.shift(); sheetNaPop.splice(0).forEach(f => f()); return; }
   const want = (history.state && history.state.sheet) || 0;
   while(sheets.length > want) closeSheet(false, true);
 });
